    },
    {
      "state": "FORM2_ISSUED",
      "required_evidence": ["CRM-bound issuance request", "unexpired secure session", "approved representative email"],
      "effects": ["CRM stores request and provider message IDs only", "CRM stores no URL, OTP, token, or secret"]
    },
    {
      "state": "FORM2_VERIFIED_SUBMITTED",
      "required_evidence": ["server-verified one-time email proof", "Contact/Account/Deal/request/destination binding", "authority confirmation", "scope acceptance", "idempotent submission"],
      "effects": ["Setup Access Status=Submitted", "Free Test Authorization Status=Signed", "Test Status=Setup Pending", "Deal Stage may become Test Authorized", "Go-Live Approval remains Not Ready or Pending Internal Approval"]
    },
    {
      "state": "SETUP_QA",
      "required_evidence": ["coverage configuration", "one test number", "fallback and rollback contacts", "immutable deployment and configuration version", "Retell binding and resolver mapping"],
      "effects": ["Deal Stage=Setup and QA", "no live call route"]
    },
    {
      "state": "INTERNAL_GO_LIVE_APPROVED",
      "required_evidence": ["Sylvara administrator approval", "approved deployment snapshot", "approved configuration-version snapshot", "approval timestamp"],
      "effects": ["Go-Live Approval Status=Approved", "configuration changes invalidate approval"]
    },
    {
      "state": "TEST_LIVE",
      "required_evidence": ["authoritative route activation", "approved snapshot still matches current deployment"],
      "effects": ["Test Start At set", "seven-day clock starts", "Deal Stage=Test Live", "accepted calls bind to exact deployment"]
    },
    {
      "state": "TEST_ENDED",
      "required_evidence": ["first end condition", "route containment", "end timestamp", "end reason"],
      "effects": ["no new intake", "prior fallback remains restorable", "duplicate events cannot reopen or recount"]
    },
    {
      "state": "RESULTS_REVIEW",
      "required_evidence": ["reconciled canonical-call report", "CRM report summary"],
      "effects": ["Deal Stage=Results Review", "recommended coverage and expected connected-minute range recorded"]
    },
    {
      "state": "PAID_SERVICE_PROPOSED",
      "required_evidence": ["selected paid plan", "recorded commercial terms"],
      "effects": ["Subscription Acceptance Status=Pending", "Deal Stage=Subscription Proposed", "no Billing subscription"]
    },
    {
      "state": "PAID_ACCEPTED",
      "required_evidence": ["separate explicit paid acceptance", "accepted terms version", "acceptance timestamp", "completed free test", "Results Review"],
      "effects": ["create or verify Billing TEST customer", "create or verify one accepted TEST subscription", "CRM updates only after Billing readback", "Closed Won only after authoritative active-subscription readback"]
    },
    {
      "state": "PAID_DECLINED_OR_NO_DECISION",
      "required_evidence": ["explicit decline or documented no-decision path"],
      "effects": ["no Billing subscription", "Deal moves to Closed Lost or Nurture", "reason recorded", "free-test evidence retained"]
    }
  ],
