# Copy this file to .env for local development only.
# Never commit the populated .env file.

# Retell AI dashboard -> API Keys
RETELL_API_KEY=

# Retell AI webhook-signing secret or approved verification value.
# Store the real value in the deployment platform's encrypted secret store.
RETELL_WEBHOOK_SIGNING_SECRET=

# Make.com custom webhook URL for the approved non-critical post-call workflow.
# Treat the real URL as a secret because possession may permit event submission.
MAKE_POST_CALL_WEBHOOK_URL=

# Optional runtime environment label: development, staging, or production.
APP_ENV=development
