    "authority": "catalyst_validated_call_analyzed_processing",
    "copy_transcript_or_recording_to_crm": false,
    "fields": [
      {
        "key": "outcome",
        "type": "canonical_outcome",
        "required": true
      },
      {
        "key": "coverage_trigger",
        "type": "AfterHours_NoAnswerOverflow_or_Unknown",
