// Source-only candidate. This button is Gabriel-only and remains unavailable
// until the exact live preconditions and provider readback contract are proven.
string button.Approve_And_Start_Free_Test(string deal_id)
{
	if(deal_id == null || !deal_id.matches("^[0-9]{1,30}$"))
	{
		return "Approval blocked: invalid Deal context.";
	}
	deal_record = zoho.crm.getRecordById("Deals",deal_id.toLong());
	if(deal_record == null || deal_record.get("id").toString() != deal_id)
	{
		return "Approval blocked: Deal readback failed.";
	}
	control_endpoint = zoho.crm.getOrgVariable("RevenueDeskFieldSetupApprovalEndpoint");
	if(control_endpoint == null || !control_endpoint.startsWith("https://"))
	{
		return "Approval blocked: control-plane configuration is incomplete.";
	}
	payload = Map();
	payload.put("schemaVersion","field-setup-approval-intent-v1");
	payload.put("dealId",deal_id);
	payload.put("intent","approve_and_start");
	approval_response = invokeurl
	[
		url :control_endpoint
		type :POST
		parameters:payload.toString()
		content-type:"application/json"
		connection:"<PRIVATE_FIELD_SETUP_CONNECTION_LINK_NAME>"
	];
	if(approval_response == null || approval_response.get("ok") != true || approval_response.get("readbackStatus") != "activation_readback_confirmed")
	{
		return "Approval blocked: no authoritative activation readback was returned.";
	}
	return "Free test activation readback confirmed for the current immutable configuration.";
}
