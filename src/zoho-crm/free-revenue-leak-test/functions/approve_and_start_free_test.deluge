/*
Owning workflow: one explicit operator action over two separate backend transitions.
Trigger: Administrator-restricted Deals record-details button.
Security: every identity is freshly read from the current Deal; the private CRM
Connection authenticates both Catalyst operations. Approval and activation use
different idempotency identities and different audit receipts. Approval is
retry-stable; the exact approved deployment and configuration reuse one activation
attempt identity so an ambiguous click can resume without forking the decision.
Failure: activation is attempted only after exact approval readback. A failed
activation returns approved/inactive and never reports the Deal as Live.
*/

result_message = "free_test_control_rejected";
try
{
	deal_id_text = ifnull(input.deal_id,"").toString().trim();
	if(deal_id_text.matches("^[1-9][0-9]{9,29}$"))
	{
		query = Map();
		query.put("fields","Intake_Submission_ID,Deployment_Record_ID,Configuration_Version");
		deal = zoho.crm.v8.getRecordById("Deals",deal_id_text.toLong(),query);
		journey_id = ifnull(deal.get("Intake_Submission_ID"),"").toString().trim();
		deployment_id = ifnull(deal.get("Deployment_Record_ID"),"").toString().trim();
		configuration_id = ifnull(deal.get("Configuration_Version"),"").toString().trim();
		identity_pattern = "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$";
		if(journey_id.matches(identity_pattern) && deployment_id.matches(identity_pattern) && configuration_id.matches(identity_pattern))
		{
			approve_digest = zoho.encryption.sha256("sylvara:route-control:approve:v1:" + deal_id_text + ":" + journey_id + ":" + deployment_id + ":" + configuration_id);
			activate_digest = zoho.encryption.sha256("sylvara:route-control:activate:v1:" + deal_id_text + ":" + journey_id + ":" + deployment_id + ":" + configuration_id);
			approve_key = approve_digest.subString(0,8) + "-" + approve_digest.subString(8,12) + "-4" + approve_digest.subString(12,15) + "-8" + approve_digest.subString(15,18) + "-" + approve_digest.subString(18,30);
			activate_key = activate_digest.subString(0,8) + "-" + activate_digest.subString(8,12) + "-4" + activate_digest.subString(12,15) + "-8" + activate_digest.subString(15,18) + "-" + activate_digest.subString(18,30);
			body = Map();
			body.put("dealId",deal_id_text);
			body.put("journeyId",journey_id);
			body.put("deploymentId",deployment_id);
			body.put("configurationVersionId",configuration_id);
			body.put("idempotencyKey",approve_key);
			headers = Map();
			headers.put("Content-Type","application/json");
			approval = invokeurl
			[
				url : "{{ROUTE_CONTROL_APPROVE_URL}}"
				type : POST
				body : body.toString()
				headers : headers
				connection : "{{ROUTE_CONTROL_CONNECTION_LINK_NAME}}"
				detailed : true
				response-format : STRING
			];
			approval_text = ifnull(approval.get("responseText"),"").toString();
			if(approval.get("responseCode").toString() == "200" && approval_text.length() <= 4096)
			{
				approval_body = approval_text.toMap();
				if(approval_body.get("ok") == true && approval_body.get("approved") == true && approval_body.get("active") == false && approval_body.get("state") == "Scheduled")
				{
					body.put("idempotencyKey",activate_key);
					activation = invokeurl
					[
						url : "{{ROUTE_CONTROL_ACTIVATE_URL}}"
						type : POST
						body : body.toString()
						headers : headers
						connection : "{{ROUTE_CONTROL_CONNECTION_LINK_NAME}}"
						detailed : true
						response-format : STRING
					];
					activation_text = ifnull(activation.get("responseText"),"").toString();
					if(activation.get("responseCode").toString() == "200" && activation_text.length() <= 4096)
					{
						activation_body = activation_text.toMap();
						if(activation_body.get("ok") == true && activation_body.get("approved") == true && activation_body.get("active") == true && activation_body.get("state") == "Live")
						{
							result_message = "free_test_activated";
						}
						else
						{
							result_message = "free_test_approved_inactive";
						}
					}
					else
					{
						result_message = "free_test_approved_inactive";
					}
				}
			}
		}
	}
}
catch(failure)
{
	info "free_test_control_failed";
}
return result_message;
