/*
Owning workflow: CRM record-bound assisted Form 1 launch.
Trigger: Administrator-restricted Leads `Open Free-Test Setup` record-details button.
Inputs: current Lead ID and the exact fixed `Leads` module API name from the button binding.
Security: Catalyst reads/initializes the canonical CRM journey with a conditional
server-side write. It receives record identity only over an authenticated private
request and returns the Catalyst access page with the one-time journey credential
only in its URL fragment. No record ID or PII enters the URL, and the credential
is never sent to Zoho Forms.
Idempotency: Catalyst conditionally initializes the journey only when blank and
rotates or resumes the token session for the authoritative canonical journey.
Failure: no URL is returned unless the exact 201 response and URL grammar verify.
Navigation: return a versioned three-field envelope to the module-specific CRM
Client Script. Only that browser-side script may call the provider-supported
external-navigation API after independently validating this result.
Logging: coarse outcomes only; never log IDs, tokens, URLs, payloads, or errors.
Rollback: disable this replacement button and leave the retained containment button.
*/

can_open = false;
destination_url = "";
rejection_code = "request_invalid";
try
{
	record_id_text = ifnull(input.record_id,"").toString().trim();
	module_text = ifnull(input.crm_module,"").toString().trim();
	valid_record = record_id_text.matches("^[1-9][0-9]{9,29}$");
	valid_module = module_text == "Leads";
	if(valid_record && valid_module)
	{
		rejection_code = "transport_envelope";
		request_body = Map();
		request_body.put("crmModule",module_text);
		request_body.put("recordId",record_id_text);
		request_headers = Map();
		request_headers.put("Content-Type","application/json");
		issue_response = invokeurl
		[
			url : "{{FORM1_ISSUE_URL}}"
			type : POST
			body : request_body.toString()
			headers : request_headers
			connection : "{{FORM1_ISSUE_CONNECTION_LINK_NAME}}"
			detailed : true
			response-format : STRING
		];
		if(issue_response != null && issue_response.containKey("responseCode") && issue_response.get("responseCode").toString() == "201" && issue_response.containKey("responseText"))
		{
			rejection_code = "response_text";
			response_text = ifnull(issue_response.get("responseText"),"").toString();
			if(response_text.length() > 0 && response_text.length() <= 4096)
			{
				rejection_code = "response_body";
				response_body = response_text.toMap();
				if(response_body != null && response_body.size() == 4 && response_body.get("ok") == true && response_body.containKey("accessUrl") && response_body.containKey("expiresAt") && response_body.containKey("requestId"))
				{
					access_url = ifnull(response_body.get("accessUrl"),"").toString();
					expires_at = ifnull(response_body.get("expiresAt"),"").toString();
					request_id = ifnull(response_body.get("requestId"),"").toString();
					prefix = "{{FORM1_ACCESS_PUBLIC_URL}}#journeyToken=";
					rejection_code = "access_url_base";
					if(access_url.startsWith(prefix) && access_url.length() == prefix.length() + 43 && !access_url.contains("?") && !access_url.contains("&") && !access_url.contains(record_id_text))
					{
						rejection_code = "access_url_token";
						if(access_url.right(43).matches("^[A-Za-z0-9_-]{43}$"))
						{
							rejection_code = "response_metadata";
							if(expires_at.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]{3})?Z$") && request_id.matches("^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"))
							{
								can_open = true;
								destination_url = access_url;
								rejection_code = "accepted";
							}
						}
					}
				}
			}
		}
	}
}
catch(failure)
{
	rejection_code = "handler_error";
	info "form1_assisted_issue_failed";
}
navigation_result = Map();
navigation_result.put("schemaVersion","crm-launch-v1");
navigation_result.put("ok",false);
navigation_result.put("accessUrl","");
if(can_open == true)
{
	navigation_result.put("ok",true);
	navigation_result.put("accessUrl",destination_url);
}
else
{
	info "form1_assisted_issue_rejected_" + rejection_code;
}
return navigation_result.toString();
