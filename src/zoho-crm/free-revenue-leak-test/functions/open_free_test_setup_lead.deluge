// Source-only candidate. Installation and execution are not authorized.
// Private endpoint and Connection bindings are substituted only in an approved
// private installation artifact; neither value belongs in Git.
string button.Open_Free_Test_Setup_Lead(string lead_id)
{
	if(lead_id == null || !lead_id.matches("^[0-9]{1,30}$"))
	{
		return "Setup could not be opened: invalid Lead context.";
	}
	lead_record = zoho.crm.getRecordById("Leads",lead_id.toLong());
	if(lead_record == null || lead_record.get("id").toString() != lead_id)
	{
		return "Setup could not be opened: Lead readback failed.";
	}
	launch_endpoint = zoho.crm.getOrgVariable("RevenueDeskFieldSetupLaunchEndpoint");
	if(launch_endpoint == null || !launch_endpoint.startsWith("https://"))
	{
		return "Setup is unavailable: launch configuration is incomplete.";
	}
	payload = Map();
	payload.put("schemaVersion","field-setup-launch-v1");
	payload.put("moduleApiName","Leads");
	payload.put("recordId",lead_id);
	launch_response = invokeurl
	[
		url :launch_endpoint
		type :POST
		parameters:payload.toString()
		content-type:"application/json"
		connection:"<PRIVATE_FIELD_SETUP_CONNECTION_LINK_NAME>"
	];
	if(launch_response == null || launch_response.get("ok") != true || launch_response.get("launchUrl") == null)
	{
		return "Setup could not be opened: launch was not verified.";
	}
	openUrl(launch_response.get("launchUrl"),"new window");
	return "Field setup opened. No form, conversion, route, email, task, or activation was performed.";
}
