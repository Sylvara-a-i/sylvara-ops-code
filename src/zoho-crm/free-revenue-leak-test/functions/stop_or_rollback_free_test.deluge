/*
Current deployment profile: free-test-journey-core-v1.
Trigger: Administrator-restricted Deals record-details button.
Security: the exact Deal, journey, and immutable Form 2 configuration identify
the operation. Deployment_Record_ID must remain blank and is never sent. The
same private Development Connection used by approval authenticates rollback.
Behavior: Catalyst performs one direct, durable, idempotent never-active stop;
Retell is not invoked and no Blueprint or CRM workflow is required.
*/

result_message = "free_test_rollback_rejected";
try
{
	deal_id_text = ifnull(input.deal_id,"").toString().trim();
	if(deal_id_text.matches("^[1-9][0-9]{9,29}$"))
	{
		query = Map();
		query.put("fields","Intake_Submission_ID,Deployment_Record_ID,Configuration_Version");
		deal = zoho.crm.v8.getRecordById("Deals",deal_id_text.toLong(),query);
		journey_id = ifnull(deal.get("Intake_Submission_ID"),"").toString().trim();
		deployment_record_id = ifnull(deal.get("Deployment_Record_ID"),"").toString().trim();
		configuration_id = ifnull(deal.get("Configuration_Version"),"").toString().trim();
		journey_pattern = "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$";
		configuration_pattern = "^form2cfgv1:[1-9][0-9]{0,29}:[a-f0-9]{40}$";
		if(journey_id.matches(journey_pattern) && deployment_record_id == "" && configuration_id.matches(configuration_pattern))
		{
			digest = zoho.encryption.sha256("sylvara:route-control:core:rollback:v1:" + deal_id_text + ":" + journey_id + ":" + configuration_id);
			rollback_key = digest.subString(0,8) + "-" + digest.subString(8,12) + "-4" + digest.subString(12,15) + "-8" + digest.subString(15,18) + "-" + digest.subString(18,30);
			body = Map();
			body.put("dealId",deal_id_text);
			body.put("journeyId",journey_id);
			body.put("configurationVersionId",configuration_id);
			body.put("idempotencyKey",rollback_key);
			body.put("reason","operator_requested");
			headers = Map();
			headers.put("Content-Type","application/json");
			rollback = invokeurl
			[
				url : "{{ROUTE_CONTROL_ROLLBACK_URL}}"
				type : POST
				body : body.toString()
				headers : headers
				connection : "{{ROUTE_CONTROL_CONNECTION_LINK_NAME}}"
				detailed : true
				response-format : STRING
			];
			rollback_text = ifnull(rollback.get("responseText"),"").toString();
			if(rollback.get("responseCode").toString() == "200" && rollback_text.length() <= 4096)
			{
				rollback_body = rollback_text.toMap();
				rollback_exact = rollback_body.get("ok") == true && rollback_body.get("action") == "rollback" && rollback_body.get("state") == "Stopped" && rollback_body.get("approved") == false && rollback_body.get("active") == false && rollback_body.get("stopped") == true && ifnull(rollback_body.get("configurationVersionId"),"").toString() == configuration_id && rollback_body.get("rollbackStatus") == "route_inactive";
				if(rollback_exact)
				{
					result_message = "free_test_stopped_and_route_inactive";
				}
			}
		}
	}
}
catch(failure)
{
	info "free_test_rollback_failed";
}
return result_message;
