// Source-only candidate. Installation and execution are not authorized.
string button.Open_Free_Test_Setup_Deal(string deal_id)
{
	if(deal_id == null || !deal_id.matches("^[0-9]{1,30}$"))
	{
		return "Setup could not be opened: invalid Deal context.";
	}
	deal_record = zoho.crm.getRecordById("Deals",deal_id.toLong());
	if(deal_record == null || deal_record.get("id").toString() != deal_id)
	{
		return "Setup could not be opened: Deal readback failed.";
	}
	launch_endpoint = zoho.crm.getOrgVariable("RevenueDeskFieldSetupLaunchEndpoint");
	if(launch_endpoint == null || !launch_endpoint.startsWith("https://"))
	{
		return "Setup is unavailable: launch configuration is incomplete.";
	}
	payload = Map();
	// Catalyst requires the exact protocol ID and numeric schemaVersion. A
	// textual label in schemaVersion is rejected before a nonce is issued.
	payload.put("protocolId","free_revenue_leak_test_field_setup_v1");
	payload.put("schemaVersion",1);
	payload.put("moduleApiName","Deals");
	payload.put("recordId",deal_id);
	launch_response = invokeurl
	[
		url :launch_endpoint
		type :POST
		parameters:payload.toString()
		content-type:"application/json"
		connection:"<PRIVATE_FIELD_SETUP_CONNECTION_LINK_NAME>"
	];
	if(launch_response == null || launch_response.get("ok") != true || launch_response.get("protocolId") != "free_revenue_leak_test_field_setup_v1" || launch_response.get("schemaVersion") != 1 || launch_response.get("launchUrl") == null)
	{
		return "Setup could not be opened: resume state was not verified.";
	}
	openUrl(launch_response.get("launchUrl"),"new window");
	return "Field setup opened at the authoritative current step. No activation was performed.";
}
