# Names and safe examples only. Keep real routes, identifiers, endpoints, and
# every secret in Catalyst Development configuration, never in GitHub.
DEPLOYMENT_ENVIRONMENT=development
SOURCE_REVISION=<reviewed-lowercase-40-character-git-commit>

ISSUE_PATH=<private-exact-post-path>
PREFILL_PATH=<private-exact-post-path>
SUBMISSION_PATH=<private-exact-post-path>
ISSUE_HEADER_NAME=<private-lowercase-x-header-name>
FORMS_HEADER_NAME=<different-private-lowercase-x-header-name>
ISSUE_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
PREFILL_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
SUBMISSION_HEADER_SECRET=<independently-generated-32-plus-byte-secret>

FORM2_PUBLIC_URL=<exact-https-forms.zohopublic.com-form-url-without-query>
FORM2_TOKEN_FIELD_ALIAS=<exact-prefill-webhook-field-alias>
FORM2_FORM_VERSION=2
FORM2_ENTRY_OFFER_VALUE=<exact-private-approved-crm-picklist-value>
FORM2_PHONE_SYSTEM_PROVIDERS=<private-json-array-of-approved-provider-values>
FORM2_FIELD_TEAM_SIZE_BANDS=<private-json-array-of-current-crm-picklist-values>
FORM2_ACCESS_STATUS_INITIAL_VALUE=<exact-private-initial-crm-picklist-value>
FORM2_ACCESS_STATUS_ISSUED_VALUE=<exact-private-issued-crm-picklist-value>
FORM2_ACCESS_STATUS_VERIFIED_VALUE=<exact-private-verified-crm-picklist-value>
FORM2_ACCESS_STATUS_SUBMITTED_VALUE=<exact-private-submitted-crm-picklist-value>
FORM2_ACCESS_STATUS_EXPIRED_VALUE=<exact-private-expired-crm-picklist-value>
TOKEN_PEPPER=<stable-independently-generated-32-plus-byte-secret>
SESSION_TTL_SECONDS=86400
MAX_VERIFICATION_ATTEMPTS=10
MAX_SUBMISSION_ATTEMPTS=3

CRM_API_BASE_URL=https://www.zohoapis.com/crm/v8
CRM_READ_CONNECTION_LINK_NAME=<private-read-connection-link-name>
CRM_WRITE_CONNECTION_LINK_NAME=<different-private-write-connection-link-name>

SESSION_TABLE_NAME=<private-session-table-api-name>
PREFILL_TABLE_NAME=<private-prefill-table-api-name>
SUBMISSION_TABLE_NAME=<private-submission-table-api-name>

MAX_BODY_BYTES=32768
INBOUND_BODY_TIMEOUT_MS=5000
OUTBOUND_TIMEOUT_MS=5000
OUTBOUND_MAX_BYTES=131072
PLATFORM_OPERATION_TIMEOUT_MS=5000
