# The committed and freshly deployed fixture remains inert until explicitly
# enabled for one bounded Zoho Forms mapping operation. Real values remain only
# in Catalyst Development protected configuration.
FORM1_PREFILL_MAPPING_FIXTURE_MODE=disabled
DEPLOYMENT_ENVIRONMENT=development
EXPECTED_CATALYST_PROJECT_ID_SHA256=<private-lowercase-sha256-of-reviewed-catalyst-project-id>
SOURCE_REVISION=<reviewed-lowercase-40-character-git-commit>
FIXTURE_PATH=<private-exact-post-path>
FIXTURE_HEADER_NAME=<private-lowercase-x-header-name-used-only-by-this-fixture>
FIXTURE_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
FIXTURE_EXPIRES_AT=<utc-timestamp-no-more-than-four-hours-after-enable-time>
