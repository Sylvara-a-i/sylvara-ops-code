{
  "schema_version": 2,
  "environment": "Development",
  "gateway_state": "desired-disabled-until-project-wide-route-preservation-readback",
  "function": "revenue_leak_test_setup_form",
  "default_action": "reject",
  "cors": false,
  "query_strings": false,
  "routes": [
    {
      "id": "FORM2_ISSUE",
      "method": "POST",
      "path_reference": "ISSUE_PATH",
      "caller": "administrator-restricted CRM action",
      "payload_contract": "issue-caller-contract.json",
      "authentication": ["Catalyst API key", "ISSUE_HEADER_NAME and ISSUE_HEADER_SECRET"],
      "content_type": "application/json",
      "rate_limit_per_minute": 30,
      "rate_limit_per_ip_per_minute": 10
    },
    {
      "id": "FORM2_ACCESS",
      "method": "GET",
      "path_reference": "FORM2_ACCESS_PATH",
      "caller": "authorized representative browser",
      "authentication": ["high-entropy setup token retained in URL fragment"],
      "content_type": "none",
      "rate_limit_per_minute": 120,
      "rate_limit_per_ip_per_minute": 30
    },
    {
      "id": "FORM2_OTP_REQUEST",
      "method": "POST",
      "path_reference": "FORM2_OTP_REQUEST_PATH",
      "caller": "same-origin Form 2 access page",
      "authentication": ["single setup-token exchange or limited verificationId", "same-origin JSON boundary"],
      "body_contracts": [["setupToken"], ["verificationId"]],
      "content_type": "application/json",
      "rate_limit_per_minute": 30,
      "rate_limit_per_ip_per_minute": 5
    },
    {
      "id": "FORM2_OTP_VERIFY",
      "method": "POST",
      "path_reference": "FORM2_OTP_VERIFY_PATH",
      "caller": "same-origin Form 2 access page",
      "authentication": ["limited verificationId", "eight-digit email OTP", "same-origin JSON boundary"],
      "body_keys": ["verificationId", "code"],
      "content_type": "application/json",
      "rate_limit_per_minute": 60,
      "rate_limit_per_ip_per_minute": 10
    },
    {
      "id": "FORM2_PREFILL",
      "method": "POST",
      "path_reference": "PREFILL_PATH",
      "caller": "Zoho Forms server-side Prefill Webhook",
      "authentication": ["Catalyst API key", "FORMS_HEADER_NAME and PREFILL_HEADER_SECRET", "one-time digest-bound prefill handle"],
      "body_keys": ["prefillHandle"],
      "content_type": "application/json",
      "rate_limit_per_minute": 120,
      "rate_limit_per_ip_per_minute": 30
    },
    {
      "id": "FORM2_SUBMISSION",
      "method": "POST",
      "path_reference": "SUBMISSION_PATH",
      "caller": "Zoho Forms server-side submission webhook",
      "authentication": ["Catalyst API key", "FORMS_HEADER_NAME and SUBMISSION_HEADER_SECRET", "verified session and one-time prefillId plus immutable revision"],
      "body_keys": ["prefillId", "configurationRevision", "submissionId", "approved Form 2 fields"],
      "content_type": "application/json",
      "rate_limit_per_minute": 60,
      "rate_limit_per_ip_per_minute": 15
    }
  ],
  "common_controls": {
    "body_size_reference": "MAX_BODY_BYTES",
    "body_timeout_reference": "INBOUND_BODY_TIMEOUT_MS",
    "cache": "no-store",
    "access_page_csp": "nonce-only same-origin connect; no frames, forms, external assets, or referrers",
    "browser_routes_expose_shared_secret": false
  },
  "activation_gates": [
    "Do not enable API Gateway until every existing route in the shared Retell Development project has equivalent reviewed preservation and rollback.",
    "Directly test the exact deployed source revision and four additive version-3 tables before changing a CRM action or Zoho Forms webhook.",
    "Keep legacy Form 2 callers and routes unchanged until email proof, prefill, submission, replay, rollback, and destination stamping pass with synthetic data.",
    "Never add SMS, optional authentication, wildcard paths, query-string tokens, or Production routes."
  ],
  "rollback": {
    "first": "restore prior CRM action and Zoho Forms webhook targets",
    "then": "disable the six new Form 2 routes",
    "preserve": ["both version-2 stores", "all four version-3 tables", "legacy function", "durable proof and submission evidence"]
  }
}
