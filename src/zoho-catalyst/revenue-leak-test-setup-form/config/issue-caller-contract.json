{
  "schema_version": 1,
  "environment": "Development",
  "controller": "revenue_leak_test_setup_form",
  "route_id": "FORM2_ISSUE",
  "caller_id": "FORM2_SETUP_ISSUE_CALLER",
  "request_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["dealId", "issueRequestId"],
    "properties": {
      "dealId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{9,29}$"
      },
      "issueRequestId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    }
  },
  "success_response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "status": 200,
    "type": "object",
    "additionalProperties": false,
    "required": ["ok", "accessUrl", "expiresAt"],
    "properties": {
      "ok": {
        "const": true
      },
      "accessUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://[^?#]+#setupToken=[A-Za-z0-9_-]{43}$"
      },
      "expiresAt": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
      }
    }
  },
  "access_url_policy": {
    "private_base_url_placeholder": "{{FORM2_ACCESS_PUBLIC_URL}}",
    "private_base_url_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?:/[A-Za-z0-9._~!$'()*+,;=%/-]*)?$"
    },
    "composition": {
      "fragment_literal": "#setupToken=",
      "token_length": 43,
      "token_pattern": "^[A-Za-z0-9_-]{43}$",
      "exact_private_base_prefix_required": true,
      "exact_total_length_required": true,
      "query_allowed": false,
      "additional_fragment_allowed": false,
      "whitespace_allowed": false
    },
    "caller_enforcement": {
      "private_renderer_must_validate_base_schema": true,
      "source_guard_regression_test_required": true,
      "open_only_after_every_guard": true
    }
  },
  "retry_policy": {
    "automatic_retry": false,
    "idempotency_field": "issueRequestId",
    "idempotency_value": "immutable canonical lowercase UUID v4",
    "exact_retry_requires_authoritative_reconciliation": true,
    "ambiguous_result_is_never_retried_blindly": true
  },
  "failure_policy": {
    "open_url": false,
    "log_body_url_header_or_error": false,
    "coarse_outcome_only": true
  }
}
