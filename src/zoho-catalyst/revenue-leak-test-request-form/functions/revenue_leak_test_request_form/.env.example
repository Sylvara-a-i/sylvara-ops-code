# Names and safe examples only. Real routes, identifiers, aliases, connection
# names, destinations, actor digests, and secrets belong only in Catalyst Development.
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_MODE=active
EXPECTED_CATALYST_PROJECT_ID_SHA256=<private-lowercase-sha256-of-reviewed-catalyst-project-id>
CRM_ORGANIZATION_ID_SHA256=<private-lowercase-sha256-of-reviewed-crm-organization-id>
SOURCE_REVISION=<reviewed-lowercase-40-character-git-commit>

ISSUE_PATH=<private-exact-post-path>
PREFILL_PATH=<different-private-exact-post-path>
SUBMISSION_PATH=<third-private-exact-post-path>
ISSUE_HEADER_NAME=<private-lowercase-x-header-name>
PREFILL_HEADER_NAME=<different-private-lowercase-x-header-name>
SUBMISSION_HEADER_NAME=<third-private-lowercase-x-header-name>
ISSUE_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
PREFILL_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
SUBMISSION_HEADER_SECRET=<independently-generated-32-plus-byte-secret>
TOKEN_PEPPER=<independently-generated-32-plus-byte-secret>
ISSUING_ACTOR_HASH=<operator_-prefixed-private-sha256-of-reviewed-caller>

FORM1_PUBLIC_URL=<exact-private-zoho-forms-public-permalink>
FORM1_TOKEN_FIELD_ALIAS=<private-form-field-alias>
CRM_READ_CONNECTION_LINK_NAME=<private-read-only-crm-connection-link-name>
CRM_WRITE_CONNECTION_LINK_NAME=<private-write-crm-connection-link-name>
SESSION_TABLE_NAME=RevenueLeakTestRequestFormSessions
CRM_API_BASE_URL=https://www.zohoapis.com/crm/v8

FORM1_ENTRY_OFFER_VALUE=Free 7-Day Missed-Call
FORM1_INTAKE_FORM_VERSION=revenue-leak-test-request-v1
FORM1_LEAD_STATUS_VALUE=Free Test Requested
FORM1_SOURCE_PAGE_VALUE=crm-assisted-form1
FORM1_SUBMISSION_CHANNEL_VALUE=CRM Assisted
SESSION_TTL_SECONDS=1800
MAX_BODY_BYTES=32768
INBOUND_BODY_TIMEOUT_MS=5000
OUTBOUND_TIMEOUT_MS=5000
OUTBOUND_MAX_BYTES=131072
PLATFORM_OPERATION_TIMEOUT_MS=5000
