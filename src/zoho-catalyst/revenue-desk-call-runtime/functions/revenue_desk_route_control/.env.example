ROUTE_CONTROL_OPERATOR_IDENTITY=<authenticated-operator-or-connection-identity>
ROUTE_CONTROL_OPERATOR_HMAC_SECRET=<secret>
ROUTE_CONTROL_EVENT_HMAC_SECRET=<distinct-secret>
ROUTE_CONTROL_MAX_BODY_BYTES=4096
PLATFORM_OPERATION_TIMEOUT_MS=3000
CRM_ORGANIZATION_ID=<development-crm-organization-id>
CRM_API_BASE_URL=https://www.zohoapis.com/crm/v8
CRM_READ_CONNECTION_LINK_NAME=<private-read-connection-link-name>
CRM_WRITE_CONNECTION_LINK_NAME=<private-write-connection-link-name>
RETELL_API_BASE_URL=https://api.retellai.com
RETELL_ROUTE_MODE=disabled
RETELL_CONNECTION_LINK_NAME=
RETELL_TEST_PHONE_NUMBER=
RETELL_SHARED_AGENT_ID=
RETELL_SHARED_AGENT_VERSION=
RETELL_INBOUND_WEBHOOK_URL=
RETELL_ROLLBACK_INSTRUCTIONS=<exact-approved-provider-rollback-instructions>
NUMBER_LOOKUP_HMAC_SECRET=<existing-runtime-number-secret>
