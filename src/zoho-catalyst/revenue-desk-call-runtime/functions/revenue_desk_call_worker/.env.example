# Private Development-only Function Job identity. Real values belong in Catalyst, not Git.
DEPLOYMENT_ENVIRONMENT=development
DEPLOYMENT_MODE=active
# Platform-injected by Catalyst; do not configure this value manually.
X_ZOHO_CATALYST_ENVIRONMENT=Development
ZOHO_CATALYST_ZCQL_PARSER=V2
SOURCE_REVISION=<reviewed-40-character-git-commit>
REVENUE_DESK_PROJECT_ID=<private-development-project-id>
REVENUE_DESK_WORKER_JOB_POOL_ID=<private-development-function-job-pool-id>

# Automatic terminal CRM summary dispatcher. Catalyst fixes the API Gateway header name as
# ZCFKEY; the second value is report-only and equals orchestrator REPORT_SUMMARY_HEADER_VALUE.
CRM_BILLING_ORCHESTRATOR_HOST=<private-development-catalyst-advanced-io-host>
CRM_BILLING_ORCHESTRATOR_URL=<private-exact-https-orchestrator-route>
CRM_BILLING_API_GATEWAY_KEY=<private-development-zcfkey-value>
CRM_BILLING_SHARED_HEADER_NAME=<private-x-header-name-matching-orchestrator>
CRM_BILLING_SHARED_HEADER_VALUE=<private-report-only-caller-secret>
CRM_BILLING_DISPATCH_TIMEOUT_MS=3000

# Shared agent and durable identity used during ownership checks.
RETELL_SHARED_AGENT_ID=<set-private-agent-id>
RETELL_SHARED_AGENT_VERSION=0
EVENT_HMAC_SECRET=<set-in-catalyst-secret>
# Shared with route control so the worker can verify authorization receipts.
ROUTE_CONTROL_EVENT_HMAC_SECRET=<set-in-catalyst-secret>
ANALYTICS_PARTITION_HMAC_SECRET=<shared-analytics-partition-secret>

# Exact canonical Revenue Desk Data Store API names.
DEPLOYMENT_TABLE=RevenueDeskDeployments
CONFIGURATION_VERSION_TABLE=RevenueDeskConfigurationVersions
EVENT_RECEIPT_TABLE=RevenueDeskEventReceipts
CANONICAL_CALL_TABLE=RevenueDeskCalls
NOTIFICATION_TABLE=RevenueDeskNotifications
ANALYTICS_OUTBOX_TABLE=AnalyticsSyncOutbox
OPERATION_TABLE=CRMBillingOperations
PLATFORM_OPERATION_TIMEOUT_MS=3000

# The worker remains dry-run unless one separately approved Development mail test is active.
REVENUE_DESK_NOTIFICATION_MODE=dry_run
REVENUE_DESK_MAIL_FROM=<verified-development-catalyst-mail-sender>
REVENUE_DESK_MAIL_TIMEOUT_MS=3000
REVENUE_DESK_NOTIFICATION_MAX_ATTEMPTS=3
