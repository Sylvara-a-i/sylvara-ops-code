{
  "schema_version": 1,
  "environment": "Development",
  "gateway_state": "desired-disabled-until-project-wide-route-preservation-readback",
  "function": "form1_assisted_controller",
  "default_action": "reject",
  "cors": false,
  "routes": [
    {
      "id": "FORM1_ISSUE",
      "method": "POST",
      "path_reference": "ISSUE_PATH",
      "caller": "administrator-restricted CRM button function",
      "authentication": {
        "type": "independent custom header",
        "name_reference": "ISSUE_HEADER_NAME",
        "secret_reference": "ISSUE_HEADER_SECRET"
      },
      "content_type": "application/json",
      "body_size_reference": "MAX_BODY_BYTES",
      "body_timeout_reference": "INBOUND_BODY_TIMEOUT_MS",
      "rate_limit_per_minute": 30,
      "rate_limit_per_ip_per_minute": 10,
      "success_status": 201
    },
    {
      "id": "FORM1_PREFILL",
      "method": "POST",
      "path_reference": "PREFILL_PATH",
      "caller": "Zoho Forms server-side Prefill Webhook",
      "authentication": {
        "type": "independent custom header",
        "name_reference": "PREFILL_HEADER_NAME",
        "secret_reference": "PREFILL_HEADER_SECRET"
      },
      "content_type": "application/json",
      "body_size_reference": "MAX_BODY_BYTES",
      "body_timeout_reference": "INBOUND_BODY_TIMEOUT_MS",
      "rate_limit_per_minute": 120,
      "rate_limit_per_ip_per_minute": 30,
      "success_status": 200
    }
  ],
  "activation_gates": [
    "Read back every existing Retell-project Advanced I/O endpoint and Security Rule before enabling API Gateway.",
    "Prove the CRM Connection organization and exact Lead READ/UPDATE scopes with a harmless ZZZ SYNTHETIC read.",
    "Deploy and directly test the exact source revision before changing the CRM button or Forms Prefill Webhook.",
    "Preserve the legacy function and its two routes until public and assisted same-Lead canaries pass.",
    "Reject any optional-auth or wildcard route."
  ],
  "rollback": {
    "first": "restore the prior CRM button and Forms Prefill Webhook targets",
    "then": "disable the two target routes",
    "preserve": ["legacy function", "legacy routes", "legacy session rows", "target session rows"]
  }
}
