# Development-only runtime identity. Real values belong in Catalyst, not Git.
DEPLOYMENT_ENVIRONMENT=development
ZOHO_CATALYST_ZCQL_PARSER=V2
SOURCE_REVISION=<reviewed-40-character-git-commit>

# Retell verification and one shared free-test agent.
RETELL_WEBHOOK_API_KEY=<set-in-catalyst-secret>
RETELL_SHARED_AGENT_ID=<set-private-agent-id>
RETELL_SHARED_AGENT_VERSION=0
RETELL_INBOUND_PATH=/retell/inbound
RETELL_EVENTS_PATH=/retell/events
RETELL_SIGNATURE_MAX_AGE_MS=300000
MAX_WEBHOOK_BYTES=262144
INBOUND_BODY_TIMEOUT_MS=5000

# Internal readiness and non-reversible lookup keys. Keep every secret distinct.
EVENT_HMAC_SECRET=<set-in-catalyst-secret>
NUMBER_LOOKUP_HMAC_SECRET=<set-in-catalyst-secret>
INTERNAL_READINESS_TOKEN=<set-in-catalyst-secret>
INTERNAL_READINESS_PATH=/internal/readiness
CATALYST_DEVELOPMENT_HOST=<private-development-advanced-io-host>
CATALYST_DEVELOPMENT_PROJECT_ID=<private-development-project-id>

# Exact reviewed Development Data Store API names.
DEPLOYMENT_TABLE=FreeTestDeployments
EVENT_RECEIPT_TABLE=FreeTestRetellEventReceipts
CANONICAL_CALL_TABLE=FreeTestCalls
NOTIFICATION_TABLE=FreeTestNotifications
PLATFORM_OPERATION_TIMEOUT_MS=3000

# This revision records an email notification dry run and never calls sendMail.
FREE_TEST_NOTIFICATION_MODE=dry_run
FREE_TEST_MAIL_FROM=<verified-development-catalyst-mail-sender>
FREE_TEST_MAIL_TIMEOUT_MS=3000
FREE_TEST_NOTIFICATION_MAX_ATTEMPTS=3
