# Development-only runtime identity. Real values belong in Catalyst, not Git.
DEPLOYMENT_ENVIRONMENT=development
SOURCE_REVISION=<reviewed-40-character-git-commit>

# Retell verification and shared agent. The API key must be a Catalyst secret.
RETELL_WEBHOOK_API_KEY=<set-in-catalyst-secret>
RETELL_SHARED_AGENT_ID=<set-private-agent-id>
RETELL_SHARED_AGENT_VERSION=0
RETELL_INBOUND_PATH=/retell/inbound
RETELL_EVENTS_PATH=/retell/events
RETELL_SIGNATURE_MAX_AGE_MS=300000
MAX_WEBHOOK_BYTES=262144
INBOUND_BODY_TIMEOUT_MS=5000

# Stable secret HMAC keys. Keep each value distinct and in Catalyst secrets.
ADMISSION_HMAC_SECRET=<set-in-catalyst-secret>
EVENT_HMAC_SECRET=<set-in-catalyst-secret>
NUMBER_LOOKUP_HMAC_SECRET=<set-in-catalyst-secret>

# Exact Development Data Store API names.
DEPLOYMENT_TABLE=<private-development-table-name>
CONFIGURATION_TABLE=<private-development-table-name>
NUMBER_ASSIGNMENT_TABLE=<private-development-table-name>
ADMISSION_SLOT_TABLE=<private-development-table-name>
ADMISSION_RECORD_TABLE=<private-development-table-name>
EVENT_RECEIPT_TABLE=<private-development-table-name>
CANONICAL_CALL_TABLE=<private-development-table-name>
NOTIFICATION_TABLE=<private-development-table-name>
REPORTING_OUTBOX_TABLE=<private-development-table-name>
PLATFORM_OPERATION_TIMEOUT_MS=3000

# This source revision deliberately supports only these non-live modes.
NOTIFICATION_MODE=synthetic
NOTIFICATION_MAX_ATTEMPTS=3
ANALYTICS_MODE=synthetic
CRM_SUMMARY_MODE=disabled
