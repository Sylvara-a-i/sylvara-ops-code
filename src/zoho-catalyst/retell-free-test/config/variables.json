{
  "schema_version": 1,
  "status": "development-only-source-contract",
  "production_supported": false,
  "rules": {
    "real_values_in_git": false,
    "missing_required_values_fail_closed": true,
    "production_values_rejected_by_source": true,
    "secret_values_logged": false
  },
  "variables": [
    {
      "name": "DEPLOYMENT_ENVIRONMENT",
      "consumer": "Catalyst request boundary and every store row",
      "secret": false,
      "required": true,
      "format": "exact literal development",
      "development": "must be development",
      "production": "rejected by this source revision"
    },
    {
      "name": "SOURCE_REVISION",
      "consumer": "Catalyst request boundary, durable audit rows, and safe logs",
      "secret": false,
      "required": true,
      "format": "lowercase 40-character Git commit SHA",
      "development": "reviewed immutable source revision",
      "production": "not supported"
    },
    {
      "name": "RETELL_WEBHOOK_API_KEY",
      "consumer": "Retell inbound and call-event HMAC verifier",
      "secret": true,
      "required": true,
      "format": "Retell API key carrying the webhook-verification badge; 24-4096 non-whitespace characters",
      "development": "Development Retell workspace secret only",
      "production": "must be separately provisioned; rejected here"
    },
    {
      "name": "RETELL_SHARED_AGENT_ID",
      "consumer": "inbound resolver response and agent-only ownership fallback",
      "secret": false,
      "required": true,
      "format": "private opaque identifier matching ^[A-Za-z0-9_-]{8,128}$",
      "development": "exact shared Development free-test agent",
      "production": "not supported"
    },
    {
      "name": "RETELL_SHARED_AGENT_VERSION",
      "consumer": "inbound resolver response",
      "secret": false,
      "required": true,
      "format": "base-10 integer from 0 through 100000",
      "development": "accepted Development version or tag index",
      "production": "not supported"
    },
    {
      "name": "RETELL_INBOUND_PATH",
      "consumer": "HTTP route boundary",
      "secret": false,
      "required": true,
      "format": "exact /retell/inbound",
      "development": "exact route",
      "production": "not supported"
    },
    {
      "name": "RETELL_EVENTS_PATH",
      "consumer": "HTTP route boundary",
      "secret": false,
      "required": true,
      "format": "exact /retell/events",
      "development": "exact route",
      "production": "not supported"
    },
    {
      "name": "RETELL_SIGNATURE_MAX_AGE_MS",
      "consumer": "Retell HMAC timestamp verifier",
      "secret": false,
      "required": true,
      "format": "exact integer 300000",
      "development": "official five-minute window",
      "production": "not supported"
    },
    {
      "name": "MAX_WEBHOOK_BYTES",
      "consumer": "HTTP raw-body reader",
      "secret": false,
      "required": true,
      "format": "integer 1024-262144",
      "development": "bounded request size",
      "production": "not supported"
    },
    {
      "name": "INBOUND_BODY_TIMEOUT_MS",
      "consumer": "HTTP raw-body reader",
      "secret": false,
      "required": true,
      "format": "integer 250-5000",
      "development": "must leave time inside Retell's ten-second inbound timeout",
      "production": "not supported"
    },
    {
      "name": "ADMISSION_HMAC_SECRET",
      "consumer": "retry-safe inbound admission key derivation",
      "secret": true,
      "required": true,
      "format": "32-4096 non-whitespace characters, distinct from every other HMAC key",
      "development": "stable for the admission retention period",
      "production": "must be separately generated; rejected here"
    },
    {
      "name": "EVENT_HMAC_SECRET",
      "consumer": "event receipt key and payload fingerprint derivation",
      "secret": true,
      "required": true,
      "format": "32-4096 non-whitespace characters, distinct from every other HMAC key",
      "development": "stable for the receipt retention period",
      "production": "must be separately generated; rejected here"
    },
    {
      "name": "NUMBER_LOOKUP_HMAC_SECRET",
      "consumer": "searchable called-number lookup hash",
      "secret": true,
      "required": true,
      "format": "32-4096 non-whitespace characters, distinct from every other HMAC key",
      "development": "stable while any assignment history remains",
      "production": "must be separately generated; rejected here"
    },
    {
      "name": "PLATFORM_OPERATION_TIMEOUT_MS",
      "consumer": "Catalyst Data Store and ZCQL adapter",
      "secret": false,
      "required": true,
      "format": "integer 250-5000",
      "development": "per-operation ceiling",
      "production": "not supported"
    },
    {
      "name": "NOTIFICATION_MODE",
      "consumer": "notification adapter selection",
      "secret": false,
      "required": true,
      "format": "exact literal synthetic",
      "development": "records deterministic synthetic delivery only",
      "production": "all sending rejected"
    },
    {
      "name": "NOTIFICATION_MAX_ATTEMPTS",
      "consumer": "notification retry state machine",
      "secret": false,
      "required": true,
      "format": "integer 1-5; approved value 3",
      "development": "bounded synthetic attempts",
      "production": "not supported"
    },
    {
      "name": "ANALYTICS_MODE",
      "consumer": "Analytics adapter selection",
      "secret": false,
      "required": true,
      "format": "exact literal synthetic",
      "development": "records a synthetic partitioned fact",
      "production": "all imports rejected"
    },
    {
      "name": "CRM_SUMMARY_MODE",
      "consumer": "CRM summary adapter selection",
      "secret": false,
      "required": true,
      "format": "exact literal disabled",
      "development": "no CRM request is permitted",
      "production": "all writes rejected"
    },
    {
      "name": "DEPLOYMENT_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name ^[A-Za-z][A-Za-z0-9_]{0,63}$",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "CONFIGURATION_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "NUMBER_ASSIGNMENT_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "ADMISSION_SLOT_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "exactly 25 pre-provisioned slots per deployment",
      "production": "not supported"
    },
    {
      "name": "ADMISSION_RECORD_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "immutable admission ledger and authoritative reconciliation tombstones",
      "production": "not supported"
    },
    {
      "name": "EVENT_RECEIPT_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "CANONICAL_CALL_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "NOTIFICATION_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    },
    {
      "name": "REPORTING_OUTBOX_TABLE",
      "consumer": "Catalyst store",
      "secret": false,
      "required": true,
      "format": "Catalyst table API name",
      "development": "Development table only",
      "production": "not supported"
    }
  ]
}
