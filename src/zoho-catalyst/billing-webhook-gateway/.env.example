# Public placeholders only. Set real values in Catalyst environment configuration.
DEPLOYMENT_ENVIRONMENT=development
BILLING_SOURCE_TIER=test
SOURCE_REVISION=<set-to-reviewed-git-commit>
ALLOWED_PATH=/billing/events
BILLING_CONTENT_TYPE=application/json
BILLING_SIGNATURE_ENCODING=<verify-in-test-organization-then-set-hex-or-base64>
BILLING_WEBHOOK_SECRET=<set-in-platform-secret-store>
BILLING_WEBHOOK_SECRET_PREVIOUS=
BILLING_WEBHOOK_SECRET_PREVIOUS_EXPIRES_AT=
BILLING_EVENT_FINGERPRINT_SECRET=<set-stable-secret-in-platform-secret-store>
BILLING_SOURCE_KEY=<set-private-stable-source-alias>
ALLOWED_EVENT_TYPES=subscription_created
BILLING_MAX_EVENT_AGE_SECONDS=604800
BILLING_MAX_FUTURE_SKEW_SECONDS=300
MAX_BODY_BYTES=262144
INBOUND_BODY_TIMEOUT_MS=5000
PLATFORM_OPERATION_TIMEOUT_MS=3000
EXECUTION_BUDGET_MS=25000
EVENT_INBOX_TABLE=<set-private-table-api-name>
DATASTORE_DUPLICATE_ERROR_CODES=<set-from-verified-development-fixture>
DELIVERY_MODE=register-only
CREATOR_FIELD_ALLOWLIST=
CREATOR_FORWARD_URL=
CREATOR_ALLOWED_HOSTS=
CREATOR_ENDPOINT_KIND=custom-api
CREATOR_TARGET_ENVIRONMENT=development
CREATOR_CONNECTION_LINK_NAME=<set-private-connection-link-name>
OUTBOUND_TIMEOUT_MS=5000
MAX_OUTBOUND_BODY_BYTES=65536
REQUIRE_SHARED_HEADER=false
SHARED_HEADER_NAME=
SHARED_HEADER_VALUE=
