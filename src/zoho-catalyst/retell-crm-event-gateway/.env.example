# Set every value in the Zoho Catalyst Development environment. Never commit real values.

# Receiver security
RETELL_WEBHOOK_API_KEY=<set-in-catalyst-secret>
VOICE_ENVIRONMENT=development
WEBHOOK_ROUTE_PATH=/retell/events
ALLOW_ROOT_WEBHOOK_PATH=false
MAX_WEBHOOK_BYTES=262144
WEBHOOK_MAX_AGE_MS=300000

# Durable receipt and job dispatch
RETELL_EVENT_TABLE=RetellEventReceipts
RETELL_JOB_POOL=retell_event_jobs
RETELL_PROCESSOR_FUNCTION=process_retell_event
RECEIPT_RETENTION_DAYS=90
NORMALIZED_PAYLOAD_MAX_BYTES=9500
RECEIVER_JOB_RETRIES=3
RECEIVER_JOB_RETRY_INTERVAL_MS=300000
CATALYST_DUPLICATE_ERROR_CODES=DUPLICATE_VALUE,DUPLICATE_DATA,ROW_ALREADY_EXISTS

# Retell event and analysis allowlists
ALLOWED_RETELL_EVENTS=call_ended,call_analyzed,transfer_started,transfer_bridged,transfer_cancelled,transfer_ended
SAFE_ANALYSIS_FIELDS=
STORE_CALL_SUMMARY=false
CALL_SUMMARY_MAX_CHARS=1500

# CRM safety gate. Keep disabled until the approved fields and Catalyst Connection exist.
CRM_WRITE_MODE=disabled
CRM_CONNECTION_LINK_NAME=<set-after-catalyst-connection-authorization>
CRM_API_BASE=https://www.zohoapis.com/crm/v8
CRM_DEALS_MODULE=Deals
CRM_CALLS_MODULE=Calls

# Required only when CRM_WRITE_MODE=enabled. Use exact Zoho CRM API names.
CRM_DEAL_AGENT_ID_FIELD=<approved-deal-field-api-name>
CRM_CALL_PROVIDER_ID_FIELD=<approved-call-field-api-name>

# Optional provider-neutral CRM fields.
CRM_DEAL_PHONE_FIELD=
CRM_CALL_PROVIDER_FIELD=
CRM_CALL_EVENT_FIELD=
CRM_CALL_PROCESSING_STATUS_FIELD=
CRM_CALL_OUTCOME_FIELD=

# Processor controls
PROCESSOR_MAX_ATTEMPTS=4
CRM_REQUEST_TIMEOUT_MS=10000
CRM_DESCRIPTION_MAX_CHARS=4000
