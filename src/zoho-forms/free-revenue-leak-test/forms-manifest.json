{
  "schema_version": 1,
  "status": "development-desired-state",
  "customer_facing_offer": "Free Revenue Leak Test",
  "real_form_ids_or_urls_in_git": false,
  "forms": [
    {
      "logical_name": "FORM1_FREE_REVENUE_LEAK_REQUEST",
      "title": "Free Revenue Leak Test",
      "purpose": "Public or CRM-assisted request intake",
      "crm_integration": {
        "module": "Leads",
        "operation": "upsert",
        "deduplication_order": ["Intake_Submission_ID", "Email"],
        "blank_overwrite": false,
        "lead_status": "Free Test Requested",
        "entry_offer": "Free Revenue Leak Test"
      },
      "required_hidden_or_locked_fields": [
        "Intake_Submission_ID",
        "Free_Test_Contact_Consent_Version",
        "Intake_Form_Version",
        "Entry_Offer",
        "Lead_Status",
        "Submission_Channel",
        "Source_Page"
      ],
      "assisted_prefill": {
        "enabled": true,
        "controller": "form1_assisted_controller",
        "route_reference": "PREFILL_PATH",
        "token_alias_reference": "FORM1_TOKEN_FIELD_ALIAS",
        "server_side_only": true
      },
      "required_behavior": [
        "immutable intake-submission identity is supplied before CRM upsert",
        "contact consent, consent version, and consent time are retained",
        "source and UTM attribution are retained",
        "duplicate submission updates one Lead",
        "one CRM review task is created",
        "no Billing, routing, SMS, or paid-service action"
      ]
    },
    {
      "logical_name": "FORM2_FREE_REVENUE_LEAK_AUTHORIZATION",
      "title": "Free Revenue Leak Test Setup and Authorization",
      "purpose": "CRM-bound setup details, bounded-test authorization, and email proof",
      "crm_integration": {
        "module": "Deals",
        "operation": "controller-mediated bounded update",
        "native_direct_write": false
      },
      "access": {
        "entry": "Catalyst email-verification access page",
        "proof_destination": "current CRM-bound Contact.Email only",
        "native_email_otp": "disabled-after-catalyst-cutover",
        "native_captcha": "optional-bot-mitigation-only-not-proof",
        "sms_otp": false,
        "sms_delivery": false
      },
      "controller_hidden_fields": ["setupToken", "prefillId"],
      "server_generated_submission_field": {
        "controller_key": "submissionId",
        "source": "Zoho Forms Unique ID",
        "format": "1-30 decimal digits without prefix or suffix"
      },
      "prohibited_hidden_fields": [
        "Contact_ID",
        "Account_ID",
        "Deal_ID",
        "Issuance_Request_ID",
        "Setup_Form_Version",
        "Test_Scope_Version"
      ],
      "controller_proof": {
        "location": "Catalyst access page",
        "not_present_in_zoho_forms": true,
        "retention": "raw code is not retained in Zoho Forms, CRM, or Catalyst"
      },
      "prefill_webhook": {
        "method": "POST",
        "route_reference": "PREFILL_PATH",
        "authentication": [
          "Catalyst API key",
          "FORMS_HEADER_NAME and PREFILL_HEADER_SECRET"
        ],
        "json_keys": ["setupToken"]
      },
      "submission_webhook": {
        "method": "POST",
        "route_reference": "SUBMISSION_PATH",
        "authentication": [
          "Catalyst API key",
          "FORMS_HEADER_NAME and SUBMISSION_HEADER_SECRET"
        ],
        "server_keys": ["setupToken", "prefillId", "submissionId"],
        "client_keys": [
          "firstName",
          "lastName",
          "decisionMakerRole",
          "jobTitle",
          "decisionAuthority",
          "businessEmail",
          "directMobileNumber",
          "companyName",
          "legalBusinessName",
          "mainBusinessNumber",
          "phoneSystemProvider",
          "primaryServiceArea",
          "normalBusinessHours",
          "fieldTeamSizeBand",
          "servicesHandled",
          "otherServiceDetails",
          "currentCallHandling",
          "requestedTestRoute",
          "approvedTestRoute",
          "requestedStartDate",
          "noAnswerDelay",
          "forwardingAdministratorName",
          "forwardingAdministratorMobile",
          "approvedFallbackDestination",
          "approvedFallbackNumber",
          "rollbackContactName",
          "rollbackContactMobile",
          "urgentCallHandling",
          "existingCustomerCallHandling",
          "alertRecipientName",
          "alertRecipientEmail",
          "authorizedRepresentativeConfirmed",
          "testScopeAccepted"
        ]
      },
      "required_fields": [
        "alertRecipientEmail",
        "authorizedRepresentativeConfirmed",
        "testScopeAccepted"
      ],
      "prohibited_fields": [
        "alertRecipientMobile",
        "smsRecipient",
        "paymentData",
        "testPhoneNumber"
      ],
      "required_copy": [
        "The representative authorizes the bounded Free Revenue Leak Test.",
        "The test lasts seven calendar days or 25 connected calls, whichever occurs first.",
        "Coverage is After Hours, No Answer / Overflow, or both as selected.",
        "Submitting this form does not approve phone-routing go-live.",
        "Sylvara separately completes setup, QA, and version-specific go-live approval.",
        "This form does not authorize paid service."
      ],
      "notification": {
        "proof_channel": "email",
        "sms": false,
        "caller_supplied_destination": false,
        "recipient_source": "CRM-bound authorized representative email"
      },
      "confirmation_copy": "Your setup information was received for Sylvara review. This does not activate call routing, confirm go-live, accept paid service, create billing, or authorize SMS.",
      "required_behavior": [
        "prefill is bound to the exact Contact, Account, Deal, issuance request, and destination",
        "submission requires server-verifiable one-time proof",
        "test-number assignment remains Setup/QA-owned and is not a respondent field",
        "authorization and scope affirmations must both be true",
        "duplicate submission has no duplicate effect",
        "no go-live approval, Billing action, paid acceptance, Zoho Sign request, or SMS"
      ]
    }
  ],
  "cutover_order": [
    "direct controller tests",
    "exact function and route readback",
    "CRM organization and Connection proof",
    "Form 1 assisted prefill caller",
    "Form 1 public ZZZ SYNTHETIC submission",
    "Form 2 issue and prefill callers",
    "Form 2 submission caller",
    "one controlled internal email proof",
    "legacy-route rollback test"
  ]
}
