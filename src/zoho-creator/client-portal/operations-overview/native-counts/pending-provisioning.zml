<panel elementName='PendingProvisioningCount'>
  <pr width='fill' height='auto'>
    <pc width='100%' padding='20px' bgColor='#FFFFFF'>
      <pr width='fill' height='auto'><pc width='100%'><text type='Text' value='Pending provisioning' size='14px' color='#536570' /></pc></pr>
      <pr width='fill' height='auto'><pc width='100%'><text type='Form Data' value='client-portal.Account_Services.ID.count' criteria='Provisioning_Status == &quot;Pending&quot;' size='32px' color='#0B3D46' /></pc></pr>
      <pr width='fill' height='auto'><pc width='100%'><text type='Text' value='Account Services &#8594; Pending' size='13px' color='#536570' /></pc></pr>
    </pc>
  </pr>
</panel>
