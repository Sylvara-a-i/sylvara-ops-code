<panel elementName='Panel 3'>
  <pr width='fill' height='auto'>
    <pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle'>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#536570' size='14px' type='Text' value='Pending provisioning'> </text>
        </pc>
      </pr>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#0B3D46' size='32px' type='Form Data' displayType='actual' criteria='Provisioning_Status == &quot;Pending&quot;' value='thisapp.Account_Services.ID.count'> </text>
        </pc>
      </pr>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#536570' size='13px' type='Text' value='Account Services → Pending'> </text>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>