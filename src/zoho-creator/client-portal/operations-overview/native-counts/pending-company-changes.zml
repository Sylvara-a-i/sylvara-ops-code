<panel elementName='PendingCompanyChangesCount'>
  <pr width='fill' height='auto'>
    <pc padding='20px' bgColor='#FFFFFF' width='100%' hAlign='left' vAlign='middle'>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#536570' size='14px' type='Text' value='Pending company changes'> </text>
        </pc>
      </pr>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#0B3D46' size='32px' type='Form Data' criteria='Status == &quot;Pending review&quot;' value='thisapp.Company_Settings_Requests.ID.count'> </text>
        </pc>
      </pr>
      <pr width='fill' height='auto'>
        <pc width='100%'>
          <text color='#536570' size='13px' type='Text' value='Settings Requests → Pending review'> </text>
        </pc>
      </pr>
    </pc>
  </pr>
</panel>