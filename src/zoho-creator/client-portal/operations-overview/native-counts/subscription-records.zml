<panel elementName='SubscriptionRecordsCount'>
  <pr width='fill' height='auto'>
    <pc width='100%' padding='20px' bgColor='#FFFFFF'>
      <pr width='fill' height='auto'><pc width='100%'><text type='Text' value='Subscription records' size='14px' color='#536570' /></pc></pr>
      <pr width='fill' height='auto'><pc width='100%'><text type='Form Data' value='client-portal.Subscriptions.ID.count' criteria='ID != 0' size='32px' color='#0B3D46' /></pc></pr>
      <pr width='fill' height='auto'><pc width='100%'><text type='Text' value='Records, not active paid plans' size='13px' color='#536570' /></pc></pr>
    </pc>
  </pr>
</panel>
